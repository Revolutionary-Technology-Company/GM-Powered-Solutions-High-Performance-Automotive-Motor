(kicad_pcb (version 20240108) (host pcbnew)

  (general
    (thickness 1.6)
    (layers
      (0 "F.Cu" signal)
      (31 "B.Cu" signal)
      (32 "F.Adhes" user "F.Adhesive")
      (33 "B.Adhes" user "B.Adhesive")
      (34 "F.Paste" user "F.Paste")
      (35 "B.Paste" user "B.Paste")
      (36 "F.SilkS" user "F.SilkScreen")
      (37 "B.SilkS" user "B.SilkScreen")
      (38 "F.Mask" user "F.Mask")
      (39 "B.Mask" user "B.Mask")
      (40 "Dwgs.User" user "User.Drawings")
      (41 "Cmts.User" user "User.Comments")
      (42 "Eco1.User" user "User.Eco1")
      (43 "Eco2.User" user "User.Eco2")
      (44 "Edge.Cuts" user "Edge.Cuts")
      (45 "F.CrtYd" user "F.Courtyard")
      (46 "B.CrtYd" user "B.Courtyard")
    )
  )

  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen"))
      (layer "F.Mask" (type "Top Solder Mask") (thickness 0.01))
      (layer "F.Cu" (type "Copper") (thickness 0.035))
      (layer "dielectric 1" (type "Core") (thickness 1.51) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "B.Cu" (type "Copper") (thickness 0.035))
      (layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.01))
      (layer "B.SilkS" (type "Bottom Silk Screen"))
    )
    (pad_to_mask_clearance 0.05)
    (clearance_class "High_Voltage_Isolation"
      (clearance 8.0)
      (trace_width 2.0)
      (via_dia 1.5)
      (via_drill 0.8)
    )
    (clearance_class "Logic_Signal"
      (clearance 0.2)
      (trace_width 0.25)
      (via_dia 0.6)
      (via_drill 0.3)
    )
  )

  (net 0 "")
  (net 1 "VCC_5V")
  (net 2 "GND_ISO")
  (net 3 "Pedal_Analog_In")
  (net 4 "Lattice_Latch_Out")
  (net 5 "VCC_HIGH_800V")
  (net 6 "GND_HIGH_POWER")
  (net 7 "Inverter_Gate_Drive_Signal")

  ;; --- Footprint Definitions & Board Positioning ---
  
  ;; J1: Amphenol IP69K Low Voltage Input Connector
  (module "Connector_Amphenol:Amphenol_Circular_3Pin_IP69K" (layer "F.Cu") (at 10.0 50.0)
    (fp_text reference "J1" (at 0 -5) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" tht circle (at -2.5 0) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask") (net 1 "VCC_5V"))
    (pad "2" tht circle (at 0 0) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask") (net 3 "Pedal_Analog_In"))
    (pad "3" tht circle (at 2.5 0) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask") (net 2 "GND_ISO"))
  )

  ;; U1: Solid State Double Latch Gold Lattice Buffer 
  (module "Custom_Lattice:Fractured_Gold_Lattice_SOIC8" (layer "F.Cu") (at 30.0 50.0)
    (fp_text reference "U1" (at 0 -4) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "2" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "Pedal_Analog_In"))
    (pad "4" smd rect (at 1.905 -2.7) (size 0.6 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "GND_ISO"))
    (net_class "Logic_Signal" (pins "2" "4"))
    (pad "6" smd rect (at 1.905 2.7) (size 0.6 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "Lattice_Latch_Out"))
    (pad "8" smd rect (at -1.905 2.7) (size 0.6 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "VCC_5V"))
    (net_class "Logic_Signal" (pins "6" "8"))
  )

  ;; U2: High-Speed Isolated Magnetic Gate Transceiver Barrier
  ;; Extends clean across the 8.0mm physical board split isolating logic from the traction field
  (module "Housings_SOIC:SOIC-8_3.9x4.9mm_Pitch1.27mm" (layer "F.Cu") (at 55.0 50.0)
    (fp_text reference "U2" (at 0 -4) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "VCC_5V"))
    (pad "2" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "Lattice_Latch_Out"))
    (pad "4" smd rect (at 1.905 -2.7) (size 0.6 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "GND_ISO"))
    (pad "5" smd rect (at 1.905 2.7) (size 0.6 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 6 "GND_HIGH_POWER"))
    (pad "7" smd rect (at -0.635 2.7) (size 0.6 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 7 "Inverter_Gate_Drive_Signal"))
    (pad "8" smd rect (at -1.905 2.7) (size 0.6 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 5 "VCC_HIGH_800V"))
    (net_class "High_Voltage_Isolation" (pins "5" "7" "8"))
  )

  ;; J2: Heavy Duty Inverter Drive Terminal Block
  (module "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MPT_0.5-2-2.54" (layer "F.Cu") (at 80.0 50.0)
    (fp_text reference "J2" (at 0 -5) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" tht circle (at -1.27 0) (size 2.0 2.0) (drill 1.2) (layers "*.Cu" "*.Mask") (net 7 "Inverter_Gate_Drive_Signal"))
    (pad "2" tht circle (at 1.27 0) (size 2.0 2.0) (drill 1.2) (layers "*.Cu" "*.Mask") (net 6 "GND_HIGH_POWER"))
  )
)
